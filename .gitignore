# Python caches, local virtual environments and tool caches.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Generated native build intermediates. Keep distributed native libraries,
# scientific OBJ geometry, packaged Viewers and SDK artifacts versioned.
*.o
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
/build/
/dist/
node_modules/

# Temporary/editor files and local runtime outputs.
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
/tmp/
/temp/
/cache/
/logs/
*.log

# Scientific evidence, manuals and examples may require authentic log files.
!docs/**/*.log
!release_evidence/**/*.log
!validation/**/*.log
!examples/**/*.log
!plugins/**/examples/**/*.log

# Plugin Manager's generated staging and managed local rollback copies.
# These remain on disk; released packages and archives are not excluded.
/plugins/.staging/
/plugins/modules/.gx-rollback-*/

# Local secrets. Keep documented configuration templates available.
.env
.env.*
!.env.example
!.env.template
!.env.sample
.secrets/
credentials.local.*

# Standalone CAD/EM tutorial sources are preserved on docs/guides118 and in
# separately staged example packages. The historical local copy stays on disk,
# outside the principal framework source/distribution.
/docs/dev109_tutorials69/
