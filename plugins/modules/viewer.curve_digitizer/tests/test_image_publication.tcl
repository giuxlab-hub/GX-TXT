# Host staging and real PNG-header validation, mocked CORE publication only.
# SPDX-License-Identifier: GPL-3.0-or-later
namespace eval ::GX {
    variable sourceSha [string repeat a 64]
    variable stagedRequest {}
}
proc ::GX::viewerBackendRegister {args} {}
proc ::GX::interactiveDocumentSessionToken {} {return test-session}
proc ::GX::sessionInspectionCurrentSession {} {return /tmp/test-processing-session}
proc ::GX::interactiveDocumentRead {id} {
    return [dict create module_id viewer.curve_digitizer provider_id curve_digitizer]
}
proc ::GX::sessionInspectionDataset {id session} {
    if {$id eq {original}} {
        return [dict create contract image.raster kind image.raster canonical_sha256 $::GX::sourceSha \
                    media_type image/png display_name {SEM photo} path original.png format png]
    }
    error {Unknown Dataset}
}
proc ::GX::sessionInspectionResolveResource {file session} {
    return [dict create path $file sha256 $::GX::sourceSha]
}
proc ::GX::datasetMetadataRead {session id} {return [dict create]}
proc ::GX::datasetFilePublicationPublish {session module request} {
    set ::GX::stagedRequest $request
    if {$module ne {viewer.curve_digitizer} || [dict get $request contract] ne {image.raster}} {
        error {invalid producer or contract}
    }
    return [dict create dataset_id [dict get $request dataset_id] sha256 [string repeat e 64]]
}
source [file join [file dirname [info script]] .. api curve_digitizer_viewer_api_v1.tcl]
set stage [::GX::CurveDigitizer::_imageStage test-session]
# A 2x1 RGB PNG generated by Pillow, provided as test bytes only.
set sample64 {iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAIAAACQd1PeAAAADklEQVR4nGNgYGD4DwABBAEAguZWkgAAAABJRU5ErkJggg==}
set file [open $stage wb];fconfigure $file -translation binary -encoding binary
puts -nonewline $file [binary decode base64 $sample64];close $file
set fields [dict create \
    curve_digitizer.image_processing.schema_version 1 \
    curve_digitizer.image_processing.producer_id viewer.curve_digitizer \
    curve_digitizer.image_processing.source_dataset_id original \
    curve_digitizer.image_processing.source_sha256 $::GX::sourceSha \
    curve_digitizer.image_processing.source_display_name original \
    curve_digitizer.image_processing.engine ImageMagick \
    curve_digitizer.image_processing.engine_version {ImageMagick 7} \
    curve_digitizer.image_processing.geometry_preserved 1 \
    curve_digitizer.image_processing.pixel_transform identity \
    curve_digitizer.image_processing.image_width 2 \
    curve_digitizer.image_processing.image_height 1 \
    curve_digitizer.image_processing.operation_count 1 \
    curve_digitizer.image_processing.operation.0.kind grayscale \
    curve_digitizer.image_processing.operation.0.value {} \
    curve_digitizer.image_processing.fingerprint [string repeat c 64]]
set records {}
dict for {key value} $fields {
    lappend records "[::GX::CurveDigitizer::_b64e $key]\t[::GX::CurveDigitizer::_b64e $value]"
}
set result [::GX::CurveDigitizer::_imagePublish test-session doc-01 original $::GX::sourceSha \
    sem.enhanced {Processed SEM} $stage [join $records "\n"]]
if {[lindex [split $result "\t"] 0] ne {sem.enhanced}} {error {wrong publication Dataset identity}}
if {[file exists $stage]} {error {staging file was not cleaned up}}
if {[dict get $::GX::stagedRequest source_dataset_ids] ne {original}} {error {missing public lineage}}
set md [dict get $::GX::stagedRequest structured_metadata]
if {[dict get $md curve_digitizer.image_processing.source_display_name] ne {SEM photo}} {error {missing authoritative display name}}
if {![catch {::GX::CurveDigitizer::_imagePublish test-session doc-01 original $::GX::sourceSha sem.second {} $stage [join $records "\n"]}]} {error {stage reused after publication}}
# Image publications also append configuration notes through the public API.
set ::GX::noteText "# Existing microscope documentation\n"
proc ::GX::datasetUserNotes {id} {return $::GX::noteText}
proc ::GX::datasetUserNotesSave {id contents} {set ::GX::noteText $contents}
set newstage [::GX::CurveDigitizer::_imageStage test-session]
set file [open $newstage wb];fconfigure $file -translation binary -encoding binary
puts -nonewline $file [binary decode base64 $sample64];close $file
set imageReceipt [::GX::CurveDigitizer::_imagePublish test-session doc-01 original $::GX::sourceSha \
    sem.with_notes {Processed SEM} $newstage [join $records "\n"] {## Edge notes
Processed with gamma 0.85.}]
if {[lindex [split $imageReceipt "\t"] 2] ne {written}} {error {processed image notes were not saved}}
if {[string first {Existing microscope documentation} $::GX::noteText] < 0 ||
    [string first {Processed with gamma 0.85.} $::GX::noteText] < 0} {error {processed image lost notes}}
puts {PASS secure image staging, public file publication, metadata, Dataset Markdown and cleanup}

