# One Builder/schema owner for allowed components and the initial numeric layout.
# No data, publication, parser or compiled callback is generated by this factory.
proc ::GX::viewerGuiPreviewComponentTypes {design} {
    if {[datasetPublicationV2DictDefault $design target viewer] ne {preview}} {return [dict keys [viewerGuiComponentCapabilities]]}
    if {[datasetPublicationV2DictDefault [dict get $design preview] runtime {}] ne {managed_cpp}} {return [dict keys [uiFieldComponentCapabilities]]}
    if {[_viewerGuiManagedNumericPreview $design]} {return {panel section splitter tabs tab label status action choice combobox field dataset_selector table plot}}
    return document
}
proc ::GX::viewerGuiDesignNumericPreviewNew {{title {Numeric Preview}}} {
    set design [viewerGuiDesignNew $title]
    dict set design target preview
    dict set design module_id preview.numeric_preview
    dict set design provider_id numeric_preview
    dict set design preview {runtime managed_cpp dataset_contracts table.generic view_role complementary}
    dict set design requirements PREVIEW_COMPONENT_GUI_API_v1 1
    dict set design requirements PLOT_DATASET_API_v4 4
    set components {}
    foreach {id type parent properties row column weight} {
        source section canvas {title Source plot_dataset dataset plot_x x plot_y y} 0 0 0
        dataset dataset_selector source {label Dataset content_kind table} 0 0 0
        x choice source {label X choices {} default {}} 1 0 0
        y choice source {label Y choices {} default {}} 2 0 0
        waveform plot canvas {title {Canonical Dataset} plot_form source} 1 0 1
        status status footer {text {Read-only current Dataset}} 0 0 0
        fit action toolbar {label Fit action fit} 0 0 0
        zoom_in action toolbar {label {Zoom in} action zoom_in} 0 1 0
        zoom_out action toolbar {label {Zoom out} action zoom_out} 0 2 0
    } {
        set layout [dict create row $row column $column weight $weight sticky nsew]
        lappend components [dict create id $id type $type parent $parent properties $properties layout $layout]
    }
    dict set design components $components
    foreach id {fit zoom_in zoom_out} {dict set design handlers $id {arguments {window action} effect presentation}}
    return [viewerGuiDesignValidate $design]
}
