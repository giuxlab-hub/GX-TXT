electrical.basic {
  module_id core.native2d version 1 license GPL-3.0-or-later
  symbols {
    resistor {title Resistor prefix R paths {{{-30 0} {-20 0} {-15 8} {-10 -8} {-5 8} {0 -8} {5 8} {10 -8} {15 8} {20 0} {30 0}}} pins {p {-30 0} n {30 0}} attributes {value {type number default 1000 min 1e-15 unit Ohm}}}
    capacitor {title Capacitor prefix C paths {{{-30 0} {-5 0}} {{-5 -16} {-5 16}} {{5 -16} {5 16}} {{5 0} {30 0}}} pins {p {-30 0} n {30 0}} attributes {value {type number default 1e-6 min 1e-18 unit F}}}
    inductor {title Inductor prefix L paths {{{-30 0} {-20 0} {-18 8} {-14 12} {-10 8} {-8 0} {-6 8} {-2 12} {2 8} {4 0} {6 8} {10 12} {14 8} {16 0} {30 0}}} pins {p {-30 0} n {30 0}} attributes {value {type number default 0.001 min 1e-15 unit H}}}
    voltage {
      title {Voltage source} prefix V
      paths {{{-30 0} {-20 0}} {{20 0} {30 0}} {{-20 0} {-18 -10} {-10 -18} {0 -20} {10 -18} {18 -10} {20 0} {18 10} {10 18} {0 20} {-10 18} {-18 10} {-20 0}}}
      variants {attribute waveform marks {
        dc {{{-12 0} {-4 0}} {{-8 -4} {-8 4}} {{6 0} {14 0}}}
        sine {{{-14 0} {-12 -5} {-9 -8} {-6 -8} {-3 -5} {0 0} {3 5} {6 8} {9 8} {12 5} {14 0}}}
        pulse {{{-14 -7} {-7 -7} {-7 7} {5 7} {5 -7} {14 -7}}}
      }}
      pins {p {-30 0} n {30 0}}
      attributes {value {type number default 1 unit V} waveform {type choice default dc values {dc pulse sine}} ac {type number default 1 min 0 unit V} initial {type number default 0 unit V} delay {type number default 0 min 0 unit s} rise {type number default 1e-9 min 1e-15 unit s} width {type number default 0.01 min 1e-15 unit s} period {type number default 0.02 min 1e-15 unit s} frequency {type number default 1000 min 1e-15 unit Hz}}
    }
    current {title {Current source} prefix I paths {{{-30 0} {-20 0}} {{20 0} {30 0}} {{-20 0} {-18 -10} {-10 -18} {0 -20} {10 -18} {18 -10} {20 0} {18 10} {10 18} {0 20} {-10 18} {-18 10} {-20 0}} {{-12 0} {12 0} {5 6}} {{12 0} {5 -6}}} pins {p {-30 0} n {30 0}} attributes {value {type number default 0.001 unit A} ac {type number default 0 min 0 unit A}}}
    ground {title Ground prefix G paths {{{0 0} {0 -12}} {{-15 -12} {15 -12}} {{-10 -18} {10 -18}} {{-5 -24} {5 -24}}} pins {g {0 0}} attributes {}}
    diode {title Diode prefix D paths {{{-30 0} {-12 0}} {{-12 -14} {-12 14} {12 0} {-12 -14}} {{12 -14} {12 14}} {{12 0} {30 0}}} pins {a {-30 0} k {30 0}} attributes {model {type choice default generic values {generic silicon}}}}
    npn {title {NPN transistor} prefix Q paths {{{-30 0} {-8 0}} {{-8 -15} {-8 15}} {{-8 8} {15 22} {30 22}} {{-8 -8} {15 -22} {30 -22}} {{15 -22} {5 -20}} {{15 -22} {12 -12}}} pins {b {-30 0} c {30 22} e {30 -22}} attributes {model {type choice default generic values {generic small_signal}}}}
    nmos {
      title {NMOS enhancement (educational)} prefix M
      paths {{{-30 0} {-8 0}} {{-8 -15} {-8 15}} {{2 8} {2 18}} {{2 -5} {2 5}} {{2 -18} {2 -8}} {{2 16} {14 22} {30 22}} {{2 -16} {14 -22} {30 -22}} {{2 0} {30 0}} {{9 5} {2 0} {9 -5}}}
      pins {d {30 22} g {-30 0} s {30 -22} b {30 0}}
      attributes {model {type choice default educational_level1 values educational_level1 label {Educational model}} length {type number default 1e-5 min 1e-6 max 0.001 unit m label {Channel length}} width {type number default 1e-4 min 1e-6 max 0.001 unit m label {Channel width}}}
    }
    pmos {
      title {PMOS enhancement (educational)} prefix M
      paths {{{-30 0} {-8 0}} {{-8 -15} {-8 15}} {{2 8} {2 18}} {{2 -5} {2 5}} {{2 -18} {2 -8}} {{2 16} {14 22} {30 22}} {{2 -16} {14 -22} {30 -22}} {{2 0} {30 0}} {{2 5} {9 0} {2 -5}}}
      pins {d {30 22} g {-30 0} s {30 -22} b {30 0}}
      attributes {model {type choice default educational_level1 values educational_level1 label {Educational model}} length {type number default 1e-5 min 1e-6 max 0.001 unit m label {Channel length}} width {type number default 1e-4 min 1e-6 max 0.001 unit m label {Channel width}}}
    }
    spst {
      title {SPST maintained (static finite contact)} prefix S
      paths {{{-30 0} {-12 0}} {{12 0} {30 0}}}
      variants {attribute position marks {open {{{-12 0} {8 12}}} closed {{{-12 0} {12 0}}}}}
      pins {a {-30 0} b {30 0}}
      attributes {position {type choice default open values {open closed} label {Static contact position}} ron {type number default 1 min 1e-6 max 1e6 unit Ohm label {Closed resistance}} roff {type number default 1e9 min 1 max 1e12 unit Ohm label {Open leakage resistance}}}
    }
    spdt {
      title {SPDT maintained (static finite contact)} prefix S
      paths {{{-30 0} {-12 0}} {{12 16} {30 16}} {{12 -16} {30 -16}}}
      variants {attribute position marks {a {{{-12 0} {12 16}}} b {{{-12 0} {12 -16}}}}}
      pins {c {-30 0} a {30 16} b {30 -16}}
      attributes {position {type choice default a values {a b} label {Static contact position}} ron {type number default 1 min 1e-6 max 1e6 unit Ohm label {Selected resistance}} roff {type number default 1e9 min 1 max 1e12 unit Ohm label {Unselected leakage resistance}}}
    }
  }
}
flow.basic {
  module_id core.native2d version 1 license GPL-3.0-or-later
  symbols {
    process {title Process prefix P paths {{{-24 -14} {24 -14} {24 14} {-24 14} {-24 -14}} {{-36 0} {-24 0}} {{24 0} {36 0}}} pins {in {-36 0} out {36 0}} attributes {caption {type string default Process}}}
    decision {title Decision prefix D paths {{{-24 0} {0 20} {24 0} {0 -20} {-24 0}} {{-36 0} {-24 0}} {{24 0} {36 0}} {{0 -20} {0 -32}}} pins {in {-36 0} yes {36 0} no {0 -32}} attributes {caption {type string default Decision}}}
  }
}
