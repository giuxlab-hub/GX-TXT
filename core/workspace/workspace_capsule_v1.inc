// Native typed interchange. No Tcl/Python scientific serialization.
namespace {
struct CapsuleBytes {
    std::string bytes; std::size_t position=0, nodes=0;
    void word(std::uint64_t n){for(unsigned i=0;i<8;++i)bytes.push_back(static_cast<char>(n>>(8*i)));}
    std::uint64_t word(){if(bytes.size()-position<8)fail("PACKAGE","Truncated native capsule");std::uint64_t n=0;for(unsigned i=0;i<8;++i)n|=std::uint64_t(static_cast<unsigned char>(bytes[position++]))<<(8*i);return n;}
    void text(const std::string& s){word(s.size());bytes+=s;if(bytes.size()>268435456)fail("LIMIT","Native capsule exceeds 256 MiB");}
    std::string text(){auto n=word();if(n>16777216||n>bytes.size()-position)fail("PACKAGE","Invalid native capsule string");auto s=bytes.substr(position,n);position+=n;return s;}
    void value(const Value& v){word(static_cast<unsigned>(v.kind));text(v.text);word(v.integer);std::uint64_t bits;std::memcpy(&bits,&v.real,8);word(bits);word(v.fields.size());for(const auto& [k,x]:v.fields){text(k);value(x);}word(v.field_order.size());for(const auto& k:v.field_order)text(k);word(v.elements.size());for(const auto& x:v.elements)value(x);}
    Value value(unsigned depth=0){if(depth>72||++nodes>2097152)fail("LIMIT","Native capsule graph exceeds bound");Value v;auto k=word();if(k>7)fail("TYPE","Invalid native capsule type");v.kind=static_cast<Kind>(k);v.text=text();v.integer=static_cast<std::int64_t>(word());auto bits=word();std::memcpy(&v.real,&bits,8);auto n=word();if(n>262144)fail("LIMIT","Native capsule object exceeds bound");while(n--){auto key=text();if(!v.fields.emplace(key,value(depth+1)).second)fail("PACKAGE","Duplicate native capsule key");}n=word();if(n>262144)fail("LIMIT","Native capsule field order exceeds bound");while(n--)v.field_order.push_back(text());n=word();if(n>262144)fail("LIMIT","Native capsule array exceeds bound");while(n--)v.elements.push_back(value(depth+1));return v;}
};
Value capsule_read(const std::string& path){
    int fd=::open(path.c_str(),O_RDONLY|O_NOFOLLOW|O_CLOEXEC);if(fd<0)fail("PACKAGE","Cannot open native capsule");CapsuleBytes data;
    try{struct stat st{};if(fstat(fd,&st)||!S_ISREG(st.st_mode)||st.st_size<80||st.st_size>268435456)fail("PACKAGE","Invalid native capsule size/type");data.bytes.resize(st.st_size);std::size_t at=0;while(at<data.bytes.size()){auto n=::read(fd,data.bytes.data()+at,data.bytes.size()-at);if(n<=0)fail("PACKAGE","Native capsule read failed");at+=n;}}catch(...){::close(fd);throw;}::close(fd);
    if(data.bytes.compare(0,8,"GXWSP001")!=0)fail("PACKAGE","Unsupported native Workspace capsule; obsolete Tcl packages are unsupported");
    data.position=8;auto sha=data.text();auto root=data.value();if(data.position!=data.bytes.size()||archive_hash(root)!=sha)fail("CORRUPT","Native capsule digest differs");return root;
}
Workspace capsule_workspace(const Value& root){
    const auto& f=root.fields;Workspace w;auto t=[&](const char* k){const auto& v=f.at(k);if(v.kind!=Kind::text)fail("PACKAGE","Invalid capsule metadata type");return v.text;};
    w.identity={t("id"),t("generation"),static_cast<std::uint64_t>(f.at("revision").integer)};if(!w.identity.revision)fail("PACKAGE","Invalid capsule revision");token(w.identity.id,"capsule identity");token(w.identity.generation,"capsule generation");
    w.owner=t("owner");w.provider=t("provider");w.schema=t("schema");w.schema_version=t("schema_version");w.name=t("name");w.notes=t("notes");w.created_at=t("created_at");w.updated_at=t("updated_at");w.content_sha256=t("sha256");w.state=f.at("state");w.properties=f.at("properties");w.provenance=f.at("provenance");name_valid(w.name);workspace_size(w);if(content_hash(w)!=w.content_sha256)fail("CORRUPT","Capsule Workspace digest differs");return w;
}
void capsule_archive_validate(const Value& value,const Workspace& w,const Value& origins){
    value_size(value);const auto& f=value.fields;
    for(const auto* k:{"provider","schema","schema_version"})if(f.at(k).kind!=Kind::text)fail("PACKAGE","Invalid archive contract");
    if(f.at("provider").text!=w.provider||f.at("schema").text!=w.schema||f.at("schema_version").text!=w.schema_version)fail("SCHEMA","Capsule archive schema differs");
    auto source=f.at("source_workspace").text,generation=f.at("source_generation").text;bool valid=source==w.identity.id&&generation==w.identity.generation;
    for(const auto& origin:origins.elements)if(origin.fields.at("id").text==source&&origin.fields.at("generation").text==generation)valid=true;
    if(!valid)fail("OWNER","Capsule archive lineage differs");
    const auto& record=f.at("record");if(f.at("owner").text!=w.owner||record.fields.at("workbench_id").text!=w.owner||record.fields.at("format").text!="gxtxt.scientific_recipe.v1"||record.fields.at("steps").elements.size()>4096)fail("HISTORY","Capsule archive scientific owner/format differs");
    if(record.kind!=Kind::object||record.fields.at("base").kind!=Kind::object||record.fields.at("steps").kind!=Kind::array||record.fields.at("cursor").kind!=Kind::integer||record.fields.at("cursor").integer<0||static_cast<std::size_t>(record.fields.at("cursor").integer)>record.fields.at("steps").elements.size())fail("HISTORY","Invalid complete capsule History");
    for(const auto& step:record.fields.at("steps").elements){
        if(step.kind!=Kind::object)fail("HISTORY","Capsule History step must be an object");
        for(const auto* key:{"api_id","api_version","operation","parameters","targets","result_ids","working_unit","patch"})if(!step.fields.count(key))fail("HISTORY","Capsule History step is incomplete");
        if(step.fields.at("api_version").kind!=Kind::integer||step.fields.at("api_version").integer!=1||step.fields.at("patch").kind!=Kind::object)fail("HISTORY","Capsule History operation version/patch differs");
    }
}
}
Value Store::capsule_inspect(const std::string& path){auto root=capsule_read(path);capsule_workspace(root);return root;}
void Store::capsule_export(const Identity& source,const std::string& path){
    {std::lock_guard<std::mutex> lock(p->mutex);p->expected(source);}flush(source.id);
    std::unique_lock<std::mutex> guard(p->mutex);p->expected(source);
    auto future=p->read_submit<Value>([source](sqlite3* db){
        Statement q(db,"SELECT generation,revision,owner,provider,schema_id,schema_version,name,notes,created_at,updated_at,content_sha256 FROM workspaces WHERE id=?");q.bind(1,source.id);if(!q.row()||q.text(0)!=source.generation||static_cast<std::uint64_t>(q.integer(1))!=source.revision)fail("CONFLICT","Workspace changed before export");Workspace w;w.identity=source;w.owner=q.text(2);w.provider=q.text(3);w.schema=q.text(4);w.schema_version=q.text(5);w.name=q.text(6);w.notes=q.text(7);w.created_at=q.text(8);w.updated_at=q.text(9);w.content_sha256=q.text(10);w=read_workspace(db,w);
        Value root=Value::object({{"id",Value::string(source.id)},{"generation",Value::string(source.generation)},{"revision",Value::number(source.revision)},{"owner",Value::string(w.owner)},{"provider",Value::string(w.provider)},{"schema",Value::string(w.schema)},{"schema_version",Value::string(w.schema_version)},{"name",Value::string(w.name)},{"notes",Value::string(w.notes)},{"created_at",Value::string(w.created_at)},{"updated_at",Value::string(w.updated_at)},{"sha256",Value::string(w.content_sha256)},{"state",w.state},{"properties",w.properties},{"provenance",w.provenance},{"archives",Value::array()},{"lineage",Value::array()}});
        Statement a(db,"SELECT archive_id,name,sha256 FROM history_archives WHERE workspace=? ORDER BY archive_id");a.bind(1,source.id);while(a.row())root.fields["archives"].elements.push_back(Value::object({{"id",Value::string(a.text(0))},{"name",Value::string(a.text(1))},{"sha256",Value::string(a.text(2))},{"content",read_archive(db,source.id,a.text(0),a.text(2))}}));
        Statement l(db,"SELECT source_id,source_generation,source_revision,source_sha256 FROM workspace_lineage WHERE workspace=? ORDER BY source_id,source_generation");l.bind(1,source.id);while(l.row())root.fields["lineage"].elements.push_back(Value::object({{"id",Value::string(l.text(0))},{"generation",Value::string(l.text(1))},{"revision",Value::number(l.integer(2))},{"sha256",Value::string(l.text(3))}}));return root;
    });guard.unlock();auto root=*future.get();if(root.fields.at("archives").elements.size()>256)fail("LIMIT","Native portable capsule permits at most 256 archives");
    CapsuleBytes bytes;bytes.bytes="GXWSP001";bytes.text(archive_hash(root));bytes.value(root);int fd=::open(path.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);if(fd<0)fail("PACKAGE","Native capsule target must be new");try{std::size_t at=0;while(at<bytes.bytes.size()){auto n=::write(fd,bytes.bytes.data()+at,bytes.bytes.size()-at);if(n<=0)fail("STORAGE","Native capsule write failed");at+=n;}if(::fsync(fd))fail("STORAGE","Native capsule sync failed");}catch(...){::close(fd);throw;}::close(fd);sync_dir(std::filesystem::path(path).parent_path());
}
Receipt Store::capsule_import(const std::string& path,std::string name){
    auto root=capsule_read(path);auto original=capsule_workspace(root);if(name.empty())name=original.name;
    auto& saved=root.fields.at("archives");auto& ancestors=root.fields.at("lineage");if(saved.kind!=Kind::array||saved.elements.size()>256||ancestors.kind!=Kind::array||ancestors.elements.size()>256)fail("LIMIT","Capsule archive/lineage bounds differ");
    std::unique_lock<std::mutex> guard(p->mutex);p->writable();p->unique_name(name);auto destination=id();while(p->entries.count(destination)||p->pending_ids.count(destination))destination=id();auto generation=random_hex();
    std::map<std::string,Impl::Archive> archives;std::map<std::string,Pins> pins;retention_collect(original.state,pins["active"]);retention_collect(original.properties,pins["active"]);retention_collect(original.provenance,pins["active"]);
    for(const auto& a:saved.elements){auto key=a.fields.at("id").text,label=a.fields.at("name").text,sha=a.fields.at("sha256").text;token(key,"archive ID");name_valid(label);const auto& content=a.fields.at("content");capsule_archive_validate(content,original,ancestors);if(archive_hash(content)!=sha||archives.count(key))fail("CORRUPT","Capsule archive digest/identity differs");for(const auto& [id,prior]:archives)if(prior.name==label)fail("NAME_EXISTS","Duplicate capsule archive name");archives.emplace(key,Impl::Archive{label,content,sha,archive_listing(key,label,content),true,{}});retention_collect(content,pins[key]);}
    std::vector<Impl::Origin> origins;for(const auto& a:ancestors.elements){value_size(a);auto id=a.fields.at("id").text,gen=a.fields.at("generation").text;token(id,"lineage ID");token(gen,"lineage generation");origins.push_back({{id,gen,static_cast<std::uint64_t>(a.fields.at("revision").integer)},a.fields.at("sha256").text});}origins.push_back({original.identity,original.content_sha256});
    Pins all;for(const auto& [scope,values]:pins)for(const auto& [key,value]:values)retention_collect(value,all);
    std::map<std::string,std::string> missing;
    for(const auto& [key,ref]:all){auto id=ref.fields.at("document_id").text,gen=ref.fields.at("owner_generation").text;auto entry=p->entries.find(id);auto sci=p->scientific_owners.find(id);if(entry!=p->entries.end()){if(entry->second.value.identity.generation!=gen)fail("RESOURCE","Imported owner generation collision");}else if(sci!=p->scientific_owners.end()){if(sci->second!=gen)fail("RESOURCE","Imported scientific owner generation collision");}else if(!missing.emplace(id,gen).second&&missing.at(id)!=gen)fail("RESOURCE","Conflicting imported owner generations");}
    // Missing immutable owner identities become native tombstones in the same
    // transaction. They never become active scientific/editor documents.
    auto schema=p->schemas.find(original.provider);if(schema==p->schemas.end()||schema->second.owner!=original.owner||schema->second.id!=original.schema||schema->second.version!=original.schema_version)fail("PROVIDER","Native portable provider is unavailable/incompatible");for(const auto& [key,kind]:schema->second.required)if(!original.state.fields.count(key)||original.state.fields.at(key).kind!=kind)fail("SCHEMA","Imported state required field differs");
    p->pending_names.insert(name);p->pending_ids.insert(destination);auto next=original;next.identity={destination,generation,1};next.name=name;next.created_at=next.updated_at=now();
    try{auto future=p->read_submit<Receipt>([this,next=std::move(next),archives=std::move(archives),pins=std::move(pins),origins=std::move(origins),missing=std::move(missing),all=std::move(all)](sqlite3* db)mutable{
        try{for(const auto& [key,ref]:all)resource_sync(std::filesystem::path(p->path).parent_path(),ref);sql(db,"BEGIN IMMEDIATE");try{
            Statement put(db,"INSERT INTO workspaces VALUES(?,?,?,?,?,?,?,?,?,?,?,?)");put.bind(1,next.identity.id);put.bind(2,next.identity.generation);put.bind(3,std::int64_t(1));put.bind(4,next.owner);put.bind(5,next.provider);put.bind(6,next.schema);put.bind(7,next.schema_version);put.bind(8,next.name);put.bind(9,next.notes);put.bind(10,next.created_at);put.bind(11,next.updated_at);put.bind(12,next.content_sha256);put.row();
            Nodes nodes=flatten(next);for(const auto& [key,a]:archives)flatten(nodes,a.content,"archive/"+key);Statement node(db,"INSERT INTO values_v1 VALUES(?,?,?,?,?,?,?,?,?)");for(const auto& [key,v]:nodes){node.reset();node.bind(1,next.identity.id);node.bind(2,key);node.bind(3,v.parent);node.bind(4,v.key);node.bind(5,static_cast<std::int64_t>(v.kind));node.bind(6,v.text);node.bind(7,v.integer);node.bind(8,v.real);node.bind(9,v.ordinal);node.row();}
            Statement archive(db,"INSERT INTO history_archives VALUES(?,?,?,?)");for(const auto& [key,a]:archives){archive.reset();archive.bind(1,next.identity.id);archive.bind(2,key);archive.bind(3,a.name);archive.bind(4,a.sha256);archive.row();}for(const auto& [scope,values]:pins)persist_pins(db,next.identity.id,scope,scope=="active"?next.content_sha256:archives.at(scope).sha256,values);
            Statement lineage(db,"INSERT INTO workspace_lineage VALUES(?,?,?,?,?) ON CONFLICT(workspace,source_id,source_generation) DO UPDATE SET source_revision=excluded.source_revision,source_sha256=excluded.source_sha256");for(const auto& origin:origins){lineage.reset();lineage.bind(1,next.identity.id);lineage.bind(2,origin.identity.id);lineage.bind(3,origin.identity.generation);lineage.bind(4,static_cast<std::int64_t>(origin.identity.revision));lineage.bind(5,origin.sha256);lineage.row();}
            Statement retired(db,"INSERT INTO retired_owners VALUES(?,?,1,?,?)");for(const auto& [id,gen]:missing){retired.reset();retired.bind(1,id);retired.bind(2,gen);retired.bind(3,next.owner);retired.bind(4,next.provider);retired.row();}sql(db,"COMMIT");}catch(...){sqlite3_exec(db,"ROLLBACK",nullptr,nullptr,nullptr);throw;}
            std::lock_guard<std::mutex> lock(p->mutex);for(const auto& [id,gen]:missing){Workspace w;w.identity={id,gen,1};w.owner=next.owner;w.provider=next.provider;p->entries.emplace(id,Impl::Entry{w,1,true,0,true,false,{}});}auto id=next.identity.id;auto preview=summary(next).has_preview;p->entries.emplace(id,Impl::Entry{std::move(next),1,false,0,true,preview,{}});auto& e=p->entries.at(id);p->names[e.value.name]=id;p->providers[e.value.provider][e.value.name]=id;p->owners[e.value.owner][e.value.name]=id;p->archives[id]=std::move(archives);p->lineage[id]=std::move(origins);p->pending_names.erase(e.value.name);p->pending_ids.erase(id);return p->receipt(e);
        }catch(...){std::lock_guard<std::mutex> lock(p->mutex);p->pending_names.erase(next.name);p->pending_ids.erase(next.identity.id);throw;}
    });guard.unlock();return *future.get();}catch(...){if(!guard.owns_lock())guard.lock();p->pending_names.erase(name);p->pending_ids.erase(destination);throw;}
}
